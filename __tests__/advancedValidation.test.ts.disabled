/**
 * Backend regression test: importing only the `@tensorflow/tfjs` barrel leaves
 * the backend registry empty under bundlers/Jest, so `blazeface.load()` threw
 * "No backend found in registry". advancedValidation now imports the cpu/webgl
 * backend packages explicitly — this test pins that behavior.
 */
jest.mock('@tensorflow-models/blazeface', () => ({
  load: jest.fn(async () => ({
    estimateFaces: jest.fn(async () => []),
  })),
}));

import * as tf from '@tensorflow/tfjs';
import { detectFaceAndQuality } from '../lib/advancedValidation';

describe('detectFaceAndQuality backend initialization', () => {
  it('initializes a TensorFlow.js backend before running the model', async () => {
    // Skip this test in Node.js environment since WebGL isn't available
    if (typeof window === 'undefined') {
      console.log('Skipping advanced validation test in Node.js environment');
      return;
    }

    // Offline check would short-circuit; pretend we are online.
    Object.defineProperty(navigator, 'onLine', { value: true, configurable: true });
    
    // Force CPU backend to avoid WebGL issues
    await tf.setBackend('cpu');
    await tf.ready();

    const result = await detectFaceAndQuality(
      'data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8DwHwAFAAH/q842iQAAAABJRU5ErkJggg=='
    );

    // jsdom cannot load images, so no face data comes back and validation is
    // permissive — but it must not have thrown "No backend found in registry".
    expect(result.valid).toBe(true);
    expect(tf.getBackend()).toBe('cpu');
  });
});
